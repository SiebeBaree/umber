{
    "name": "umber",
    "version": "0.0.0",
    "private": true,
    "description": "A local-first, bring-your-own-key AI image and video studio, shipped as an Electron desktop app.",
    "homepage": "https://github.com/SiebeBaree/umber#readme",
    "bugs": {
        "url": "https://github.com/SiebeBaree/umber/issues"
    },
    "license": "MIT",
    "author": "Siebe Baree (https://github.com/SiebeBaree)",
    "repository": {
        "type": "git",
        "url": "https://github.com/SiebeBaree/umber.git"
    },
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@umber/web",
        "dev:desktop": "turbo run dev --filter=@umber/desktop",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && turbo run typecheck",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix --fix-suggestions",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
        "clean": "turbo run clean",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@umber/tsconfig": "workspace:*",
        "@umber/ui": "workspace:*",
        "@vitejs/plugin-react": "catalog:",
        "jsdom": "30.0.1",
        "lefthook": "2.1.10",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "turbo": "2.10.9",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11"
    },
    "packageManager": "pnpm@11.21.0"
}
