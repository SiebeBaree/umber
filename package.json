{
    "name": "umber",
    "version": "0.0.0",
    "private": true,
    "description": "Umber",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@umber/web",
        "dev:desktop": "turbo run dev --filter=@umber/desktop",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && turbo run typecheck",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix --fix-suggestions",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && turbo run build",
        "clean": "turbo run clean"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@umber/tsconfig": "workspace:*",
        "@umber/ui": "workspace:*",
        "@vitejs/plugin-react": "6.0.5",
        "jsdom": "30.0.1",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "turbo": "2.10.9",
        "typescript": "7.0.2",
        "vite": "8.2.1",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11"
    },
    "packageManager": "pnpm@11.21.0"
}
