{
    "name": "@umber/desktop",
    "version": "0.0.0",
    "private": true,
    "description": "The Electron shell for Umber. Mounts @umber/ui and nothing else.",
    "license": "MIT",
    "main": "./out/main/index.js",
    "scripts": {
        "build": "electron-vite build",
        "clean": "rimraf out release .turbo",
        "dev": "node scripts/ensure-electron.mjs && electron-vite dev --watch",
        "package": "electron-vite build && electron-builder --dir",
        "release": "electron-vite build && electron-builder",
        "start": "node scripts/ensure-electron.mjs && electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
    },
    "devDependencies": {
        "@tailwindcss/vite": "catalog:",
        "@types/node": "24.13.3",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@umber/brand": "workspace:*",
        "@umber/tsconfig": "workspace:*",
        "@umber/ui": "workspace:*",
        "@vitejs/plugin-react": "catalog:",
        "electron": "43.3.0",
        "electron-builder": "26.15.3",
        "electron-vite": "6.0.0-beta.1",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rimraf": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    }
}
