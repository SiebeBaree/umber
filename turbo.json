{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalDependencies": [".oxlintrc.json", ".oxfmtrc.json", "packages/tsconfig/*.json"],
    "globalEnv": ["NODE_ENV"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "env": ["GITHUB_TOKEN", "NEXT_PUBLIC_*"],
            "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": ["^build", "^typecheck"]
        },
        "package": {
            "dependsOn": ["build"],
            "cache": false
        },
        "clean": {
            "cache": false
        }
    }
}
