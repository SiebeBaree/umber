        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@umber/tsconfig": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rimraf": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.0"
    }
}
