{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "arrowParens": "always",
    "bracketSpacing": true,
    "objectWrap": "preserve",
    "endOfLine": "lf",
    "sortImports": true,
    "sortPackageJson": true,
    "ignorePatterns": [
        "**/dist/**",
        "**/out/**",
        "**/release/**",
        "**/coverage/**",
        "pnpm-lock.yaml"
    ]
}
